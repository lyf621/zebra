  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4370585be9645454c8fd58de3c58e7ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MainMenuCredits
  entries:
  - RoleEnglish: 'Team: Zebra'
    RoleChinese: "\u5C0F\u7EC4\uFF1A\u201C\u6591\u9A6C\u201D"
    Names: Lin Yifan, Rao Hengyu
    NamesChinese: "\u6797\u8F76\u51E1\uFF0C\u9976\u6052\u745C"
  - RoleEnglish: Gameplay Design
    RoleChinese: "\u73A9\u6CD5\u8BBE\u8BA1"
    Names: 'The inspirations for gameplay came from Dune: Imperium. Wiki: https://en.wikipedia.org/wiki/Dune:_Imperium'
    NamesChinese: "\u6E38\u620F\u73A9\u6CD5\u8BBE\u8BA1\u7075\u611F\u6765\u81EA\u6C99\u4E18\uFF1A\u5E1D\u56FD\u3002Wiki:
      https://en.wikipedia.org/wiki/Dune:_Imperium"
  - RoleEnglish: Map Art
    RoleChinese: "\u5730\u56FE\u7F8E\u672F"
    Names: 'The map was designed in the creation mode of Kingdoms and Castles. View
      the game on Steam: https://store.steampowered.com/app/569480/Kingdoms_and_Castles/'
    NamesChinese: "\u5730\u56FE\u8BBE\u8BA1\u662F\u7528\u738B\u56FD\u4E0E\u57CE\u5821\u7684\u521B\u9020\u6A21\u5F0F\u5B8C\u6210\u7684\u3002\u5728Steam\u4E0A\u6D4F\u89C8\u6E38\u620F\uFF1Ahttps://store.steampowered.com/app/569480/Kingdoms_and_Castles/"
  - RoleEnglish: Font
    RoleChinese: "\u5B57\u4F53"
    Names: LXGW WenKai and Noto Sans SC, licensed under SIL OFL 1.1.
    NamesChinese: LXGW WenKai and Noto Sans SC, licensed under SIL OFL 1.1.
  - RoleEnglish: Card & UI Assets
    RoleChinese: "\u5361\u724C & UI\u8D44\u6E90"
    Names: "Parchment texture: \u201CPergament.2\u201D by Membeth, CC0,\nhttps://commons.wikimedia.org/wiki/File:Pergament.2.jpg\nAigei,\nhttps://www.aigei.com/set/kapaibiankuang.html\nhttps://www.aigei.com/set/pukepaizhipai_paibei.html"
    NamesChinese: "Parchment texture: \u201CPergament.2\u201D by Membeth, CC0,\nhttps://commons.wikimedia.org/wiki/File:Pergament.2.jpg\nAigei,\nhttps://www.aigei.com/set/kapaibiankuang.html\nhttps://www.aigei.com/set/pukepaizhipai_paibei.html"
  - RoleEnglish: Location Label Assets
    RoleChinese: "\u5730\u70B9\u6807\u7B7E\u7D20\u6750"
    Names: "Ornament design inspired by \u201CVintage swirl blank badge\u201D by
      rawpixel.com on Freepik.\nhttps://www.freepik.com/free-vector/vintage-swirl-blank-badge_3788223.htm"
    NamesChinese: "\u6807\u7B7E\u88C5\u9970\u8BBE\u8BA1\u53C2\u8003\u4E86 rawpixel.com
      \u5728 Freepik \u53D1\u5E03\u7684\u201CVintage swirl blank badge\u201D\u3002\nhttps://www.freepik.com/free-vector/vintage-swirl-blank-badge_3788223.htm"
  - RoleEnglish: Music
    RoleChinese: "\u97F3\u4E50"
    Names: 'Background music: In Taberna Revisited - Andreas Waldetoft

      Album:
      Crusader Kings III Original Soundtrack'
