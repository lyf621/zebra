  eventDescriptionChinese: "\u738B\u56FD\u4F20\u7EDF\u7684\u590F\u5B63\u8282\u65E5\u5C31\u8981\u5230\u4E86\u3002\u6240\u6709\u4EBA\u90FD\u5728\u671F\u5F85\u67D0\u79CD\u5E86\u795D\u6D3B\u52A8\u3002\u8FD9\u662F\u6211\u4EEC\u4E3E\u529E\u4E00\u573A\u76DB\u5BB4\u6765\u62C9\u62E2\u7EDF\u6CBB\u9636\u5C42\u6216\u8005\u666E\u7F57\u5927\u4F17\u7684\u673A\u4F1A\u3002"
