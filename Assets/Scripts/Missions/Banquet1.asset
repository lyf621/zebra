  missionDescriptionChinese: "\u7528\u94F6\u8D28\u9910\u76D8\u7AEF\u4E0A\u9910\u684C\u7684\u5962\u534E\u83DC\u80B4\uFF0C\u541F\u6E38\u8BD7\u4EBA\u98D8\u8361\u5728\u7A7A\u6C14\u4E2D\u7684\u6B4C\u58F0\u2026\u2026\u6211\u4EEC\u9AD8\u8D35\u7684\u5BA2\u4EBA\u4EEC\u4F1A\u88AB\u6211\u4EEC\u7684\u6177\u6168\u548C\u7CBE\u81F4\u54C1\u5473\u6DF1\u6DF1\u9707\u64BC\u3002"
