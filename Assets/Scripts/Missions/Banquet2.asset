  missionDescriptionChinese: "\u4E00\u573A\u516C\u4F17\u5BB4\u4F1A\uFF0C\u6324\u6EE1\u4E86\u9189\u9152\u7684\u519C\u6C11\uFF0C\u5730\u677F\u5728\u5435\u95F9\u7684\u6C11\u6B4C\u58F0\u91CC\u9707\u52A8\u2026\u2026
